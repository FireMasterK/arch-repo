# Maintainer: Kavin <20838718+FireMasterK@users.noreply.github.com>
# Based on the AUR cursor-bin package.

pkgname=cursor
pkgver=3.30.8
pkgrel=1
pkgdesc='AI-first coding environment'
arch=('x86_64')
url='https://www.cursor.com'
license=('LicenseRef-Cursor_EULA')
# Upstream uses a newer Electron than the bundled VSCode, so use the system one.
_electron=electron43
depends=(
  xdg-utils
  ripgrep
  "$_electron"
  nodejs
  gcc-libs
  hicolor-icon-theme
  libxkbfile
)
provides=('cursor-bin')
conflicts=('cursor-bin')
options=(!strip !debug) # Do not break the VSCode extension host.

# Updated by update.sh from cursor.com/api/download.
_commit=4a44c846d0b817fab060823f93c63ea2861ac192
_deb="cursor_${pkgver}_amd64.deb"

source=(
  "https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/${_deb}"
  "https://gitlab.archlinux.org/archlinux/packaging/packages/code/-/raw/main/code."{sh,mjs}
  rg.sh
)
sha256sums=('9c5ec4cab93cdb0c591ee13bb3be467547d6ad3b06eeb54e19ab45102e8c3094'
            '5da1525b5fe804b9192c05e1cbf8d751d852e3717fb2787c7ffe98fd5d93e8c1'
            '1ffe389c5caeb1b022cd5ee8616cab62fba168c5efba88d119db9b483878b941'
            '726022284725e2e971a17b9f900b90ae993ee70127fca2f6adb89e2f7e0a3610')
noextract=("$_deb") # Avoid unpacking the deb itself; package() streams data.tar.xz.

_app=usr/share/cursor/resources/app

package() {
  # Extract the deb payload, minus Electron (we depend on the system package)
  # and the bundled .pak locale files.
  bsdtar -xOf "$_deb" data.tar.xz | tar -xJf - -C "$pkgdir" \
    --exclude 'usr/share/cursor/[^r]*' --exclude 'usr/share/cursor/*.pak'

  cd "$pkgdir"
  mv usr/share/zsh/vendor-completions usr/share/zsh/site-functions

  ln -sf /usr/bin/node "${_app}/resources/helpers/node"
  install -Dm755 "${srcdir}/rg.sh" "${_app}/node_modules/@vscode/ripgrep/bin/rg"
  ln -sf /usr/bin/xdg-open "${_app}/node_modules/open/xdg-open"

  sed -e "1s|.*|#!/usr/lib/${_electron}/electron|" \
      -e 's|code-oss|cursor|g' -e 's|code.mjs|cursor.mjs|g' \
    "${srcdir}/code.mjs" | install -Dm644 /dev/stdin "${pkgdir}/${_app}/cursor.mjs"

  sed -e 's|code-flags|cursor-flags|' \
      -e "s|/usr/lib/code|/${_app}|" \
      -e "s|/usr/lib/code/code.mjs|/${_app}/cursor.mjs|" \
      -e "s|name=electron|name=${_electron}|" \
    "${srcdir}/code.sh" | install -Dm755 /dev/stdin "${pkgdir}/usr/share/cursor/cursor"

  install -d "$pkgdir/usr/bin"
  ln -sf /usr/share/cursor/cursor "$pkgdir/usr/bin/cursor"
}
