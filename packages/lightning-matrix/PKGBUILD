# Maintainer: Kavin <20838718+FireMasterK@users.noreply.github.com>
# Based on the AUR lightning-matrix-appimage package.

pkgname=lightning-matrix
pkgver=0.10.5
pkgrel=4
pkgdesc='Native Qt 6 Matrix desktop client using the official Rust Matrix SDK'
arch=('x86_64')
url='https://www.lightning-matrix.org/'
license=('GPL-3.0-or-later')
depends=(
  gcc-libs
  glibc
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-good
  gst-plugin-pipewire
  hicolor-icon-theme
  libnice
  libsecret
  openssl
  qt6-base
  qt6-declarative
  qt6-multimedia
  qt6-svg
  qt6-wayland
  zlib
)
makedepends=(
  cmake
  gst-plugins-bad
  gst-plugins-base
  gstreamer
  libsecret
  mold
  ninja
  openssl
  pkgconf
  qt6-base
  qt6-declarative
  qt6-multimedia
  qt6-svg
  qt6-tools
  rust
  zlib
)
optdepends=(
  'enchant: spell checking in the composer'
  'gst-libav: additional media codecs'
  'gst-plugins-ugly: additional media codecs'
  'kimageformats: JPEG XL and other extra image formats'
  'noto-fonts-emoji: colour emoji rendering'
  'qt6-imageformats: WebP and other extra image formats'
  'xdg-desktop-portal: screen sharing under Wayland'
)
conflicts=('lightning-matrix-appimage')
options=('!debug')

# CachyOS' compiler flags (pacman/makepkg.conf), pinned to the x86-64-v3
# baseline instead of -march=native so the package stays portable, and linked
# with mold. -march=native and -march=znver* are avoided on purpose: the
# package is built on GitHub's Azure runners (Skylake/EPYC), so `native` would
# silently target the wrong microarchitecture.
_cflags=(
  -march=x86-64-v3 -mtune=generic -O3 -pipe
  -fno-plt -fexceptions
  -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security
  -fstack-clash-protection -fcf-protection
)
_cxxflags=("${_cflags[@]}" -Wp,-D_GLIBCXX_ASSERTIONS)
_ldflags=(
  -Wl,-O1 -Wl,--sort-common -Wl,--as-needed
  -Wl,-z,relro -Wl,-z,now -Wl,-z,pack-relative-relocs
  -fuse-ld=mold
)
# LTO for the C++/Qt tree, like a stock Arch build. It stays out of the CFLAGS
# cargo sees: the cc crate compiles aws-lc and the bundled SQLite into the Rust
# archive, and GCC LTO IR there would need -flto on cargo's own link steps as
# well. Cargo already runs fat LTO over the SDK itself (rust/Cargo.toml).
_lto=(-flto=auto)
# Same CPU baseline for the Rust SDK. `-fuse-ld=mold` only affects the
# executables rustc links itself (build scripts and proc macros); the SDK is a
# static library the C++ link consumes.
_rustflags=(-C target-cpu=x86-64-v3 -C link-arg=-fuse-ld=mold)

_upstream="lightning-${pkgver}"

source=("${_upstream}.tar.gz::https://github.com/Mizerd/lightning/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('479d2730e6641379012792d1a6c5d79e66fc2e5521255da39cab46e1cad89fce')

prepare() {
  # CMake drives cargo with --offline --locked, so the crates pinned by
  # Cargo.lock have to be in a CARGO_HOME this build owns. Fetching them here
  # keeps the source list deterministic: Cargo.lock pins every version and
  # checksum.
  export CARGO_HOME="$srcdir/cargo-home"
  mkdir -p "$CARGO_HOME"
  cargo fetch --locked --manifest-path "$srcdir/$_upstream/rust/Cargo.toml"
}

build() {
  export CARGO_HOME="$srcdir/cargo-home"

  # Exported so the C/C++ dependencies cargo compiles itself (aws-lc, SQLite)
  # get the same optimisation flags.
  export CFLAGS="${_cflags[*]}"
  export CXXFLAGS="${_cxxflags[*]}"
  export LDFLAGS="${_ldflags[*]}"
  export RUSTFLAGS="${_rustflags[*]}"

  # The install type is left at its default "development": Arch packages are
  # updated by pacman, so the bundled updater must never replace files itself.
  cmake -S "$srcdir/$_upstream" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="${_cflags[*]} ${_lto[*]}" \
    -DCMAKE_CXX_FLAGS="${_cxxflags[*]} ${_lto[*]}" \
    -DCMAKE_EXE_LINKER_FLAGS="${_ldflags[*]} ${_lto[*]}" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DENABLE_RUST_SDK_BACKEND=ON \
    -DLIGHTNING_RUST_ONLY=ON \
    -DLIGHTNING_ARTIFACT_KIND=release \
    -DLIGHTNING_ENABLE_WEBRTC=ON \
    -DLIGHTNING_REQUIRE_WEBRTC=ON \
    -DLIGHTNING_REQUIRE_QT_SVG=ON

  # The Rust backend pulls in C libraries it compiles itself (aws-lc for rustls,
  # SQLite for matrix-sdk). rustc copies their objects into
  # libmatrix_client_rust.a but leaves them out of the archive's symbol index,
  # and ld only reads the index, so the C++ link fails with undefined
  # aws_lc_0_*_*/sqlite3_* references. Build the Rust library on its own and
  # re-index it before the rest of the tree is linked.
  rustlib=build/rust/release/libmatrix_client_rust.a
  cmake --build build --target matrix-client-rust-build
  ranlib "$rustlib"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build --prefix /usr

  install -Dm644 "$srcdir/$_upstream/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$_upstream/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/$_upstream/packaging-ci/packaging/common/lightning.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/lightning.metainfo.xml"
}
