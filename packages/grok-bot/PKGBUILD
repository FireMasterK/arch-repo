# Maintainer: Kavin <20838718+FireMasterK@users.noreply.github.com>
# Based on the AUR grok-bot-bin package.

pkgname=grok-bot
pkgver=1.0.3
pkgrel=1
pkgdesc='Grok Bot desktop agent'
arch=('x86_64')
url='https://cursor.com'
license=('LicenseRef-Proprietary')
depends=(
  gtk3
  libnotify
  nss
  libxss
  libxtst
  xdg-utils
  at-spi2-core
  util-linux-libs
  libsecret
  hicolor-icon-theme
  alsa-lib
  libappindicator
  libxkbcommon
  libdrm
  mesa
)
makedepends=('python')
optdepends=('apparmor: load the shipped userns profile')
provides=('sand' 'grok-bot-bin')
conflicts=('sand' 'grok-bot-bin' 'grokbot-linux-port' 'grokbot-linux-port-bin')
replaces=('grok-bot-bin')
options=('!strip' '!debug')

# Updated by update.sh from the x.ai/bot download links.
_commit=be8eaf76ba888db05a6a8950922f5fc8bb4d14e9
_deb="grok-bot_${pkgver}_amd64.deb"

source=(
  "${_deb}::https://downloads.cursor.com/grokbot/stable/${_commit}/linux/x64/${_deb}"
  grok-bot.sh
  linux-tray.cjs
  extract-asar.py
)
sha256sums=('ef90d8171fe207f39b887753c1ff492c6684a1a9f910d6e1dfa0303889fcf8f0'
            '9b3cccfada1dbe44ce794177181515aaf328603484327ef72a914234544bfbf8'
            '9ea1f1939677ec7364bc024ec4b87f8873ef41e6b1b5cec407d0a022ca3678f6'
            '86e6a9d2ce60f974c002a0187fdca7f111744ff4a1187dc70ba415fe6c715942')
noextract=("$_deb")

package() {
  bsdtar -O -xf "$_deb" data.tar.xz | bsdtar -C "$pkgdir" -xJf -

  # Keep app.asar packed. Unpacking makes the renderer load Vite chunks over
  # file://, which Chromium rejects as failed dynamic imports. Inject a
  # StatusNotifierItem wrapper (Omarchy/Hyprland tray) into the asar instead.
  local _res="${pkgdir}/opt/Grok Bot/resources"
  python "${srcdir}/extract-asar.py" inject-tray \
    "${_res}/app.asar" "${_res}/app.asar.unpacked" \
    "${srcdir}/linux-tray.cjs"

  # electron-builder ships an unconfined userns profile that Debian's postinst
  # copies to /etc/apparmor.d; pacman never runs that hook.
  install -Dm644 "${_res}/apparmor-profile" \
    "${pkgdir}/etc/apparmor.d/grok-bot"

  # Debian's postinst uses update-alternatives; pacman never runs that either.
  install -Dm755 "${srcdir}/grok-bot.sh" "${pkgdir}/usr/bin/grok-bot"
  ln -s grok-bot "${pkgdir}/usr/bin/sand"

  sed -i 's|^Exec=.*|Exec=grok-bot %U|' \
    "${pkgdir}/usr/share/applications/grok-bot.desktop"

  install -Dm644 "${pkgdir}/opt/Grok Bot/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  install -Dm644 "${pkgdir}/opt/Grok Bot/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

  rm -rf "${pkgdir}/usr/share/doc"

  # The SUID chrome-sandbox is only needed when user namespaces are unavailable
  # (e.g. linux-hardened). Stock Arch kernels already provide them.
  if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
    chmod 4755 "${pkgdir}/opt/Grok Bot/chrome-sandbox"
  fi
}
